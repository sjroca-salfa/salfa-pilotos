<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PortalesSalfa" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/salfa_red</item>
        <item name="colorPrimaryVariant">@color/salfa_burgundy</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/salfa_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/salfa_dark</item>
        <item name="android:windowBackground">@color/salfa_dark</item>
    </style>

    <style name="Theme.PortalesSalfa.Splash" parent="Theme.PortalesSalfa">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <style name="BottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
    </style>

    <style name="BottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>
</resources>
