<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema Principal Sin ActionBar (FullScreen WebView Corporativo) -->
    <style name="Theme.SalfaFlow" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/salfa_red</item>
        <item name="colorPrimaryVariant">@color/salfa_burgundy</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/salfa_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/salfa_dark</item>
        <item name="android:windowBackground">@color/salfa_dark</item>
    </style>

    <!-- Tema Splash Screen Salfa Montajes -->
    <style name="Theme.SalfaFlow.Splash" parent="Theme.SalfaFlow">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
</resources>
