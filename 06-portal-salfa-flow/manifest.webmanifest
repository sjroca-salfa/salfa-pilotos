{
  "name": "Salfa Flow · Gestión de Proyectos y Obras",
  "short_name": "Salfa Flow",
  "description": "Plataforma móvil corporativa de gestión de tareas, proyectos y minutas en faena para Salfa Montajes",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#161616",
